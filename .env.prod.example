# ===========================================================================
# CAD Hub — Production Environment Variables
# Copy to .env.prod and fill in real values
# NEVER commit .env.prod to git
# ===========================================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-long-random-string-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=nl2cad.de,www.nl2cad.de,127.0.0.1,localhost

# Database (PostgreSQL)
POSTGRES_DB=cad_hub
POSTGRES_USER=cad_hub
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Celery
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=info

# LLM (for Chat-Agent)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

# Image tag (managed by deploy script)
IMAGE_TAG=latest

# =============================================================================
# CAD Hub — Environment Variables (.env.prod on server)
# =============================================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-real-secret-key
ALLOWED_HOSTS=nl2cad.de,www.nl2cad.de
DEBUG=false

# Database
POSTGRES_DB=cad_hub
POSTGRES_USER=cad_hub
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://cad_hub:change-me@db:5432/cad_hub

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Docker / GHCR
IMAGE_TAG=latest
APP_NAME=cad-hub
APP_PORT=8094

# OpenAI (optional, for LLM features)
OPENAI_API_KEY=

# Registry — GitHub Actions Tenant-Onboarding Trigger
# PAT mit 'workflow' scope: https://github.com/settings/tokens
GITHUB_REGISTRY_TOKEN=
GITHUB_REGISTRY_OWNER=achimdehnert
GITHUB_REGISTRY_REPO=nl2cad

# authentik OIDC / SSO (ADR-142)
# Local dev: keep OIDC_ENABLED=false (no Authentik). Prod/staging: true.
OIDC_ENABLED=false
OIDC_APP_SLUG=cad-hub
OIDC_RP_CLIENT_ID=cad-hub
OIDC_RP_CLIENT_SECRET=
# OIDC_IDP_BASE_URL=https://id.iil.pet

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
